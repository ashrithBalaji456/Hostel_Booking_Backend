# Application Profile
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# PostgreSQL Database
DB_URL=jdbc:postgresql://localhost:5432/hostel_booking
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Security (Use a strong 32+ char random secret in production)
JWT_SECRET=replace-with-a-secure-256-bit-secret-key-in-production
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173

# Booking Rules
BOOKING_HOLD_EXPIRATION_MINUTES=15
BOOKING_APPROVAL_EXPIRATION_HOURS=24
CANCELLATION_FREE_HOURS=24
CANCELLATION_FEE_PERCENTAGE=20

# Payment Provider (MOCK or RAZORPAY)
PAYMENT_PROVIDER=MOCK
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Rate Limiting
AUTH_RATE_LIMIT_PER_MIN=20
